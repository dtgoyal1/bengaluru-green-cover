.venv/
__pycache__/
*.py[cod]

/data/
out/
*.tif
*.tiff
*.geojson
*.pmtiles
*.mbtiles

.DS_Store
.ipynb_checkpoints/

# rendered site frames: 7.8MB of derived JPG/PNG, regenerate with
#   python render_sites.py && python build_contact_sheet.py
results/imagery/*.jpg
results/imagery/*.png

# the per-pixel change map picture: 10 MB, regenerate with
#   python render_change_map.py
results/m2_change_map.png

# lake sample frames (Esri photos are for viewing, not redistribution), regenerate with
#   python sample_lakes.py [--band LO HI]
results/m4_lake_sample/*/*.jpg

# ring-loss frames (Esri photos are for viewing, not redistribution), regenerate with
#   python render_ring_losses.py
results/m4_ring_photos/

# site data: the GeoJSON and card photos are small and committed; the photo tiles
# (~29 MB) regenerate with  python export_tiles.py  (cached tiles under out/)
!site/data/*.geojson

# the swipe photos as plain tiles (~29 MB, 1,584 files); regenerate with  python export_tiles.py
site/data/tiles/
